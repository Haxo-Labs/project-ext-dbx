# Database Configuration
REDIS_URL=redis://default:redispw@localhost:55000
POOL_SIZE=10

# Server Configuration
HOST=0.0.0.0
PORT=3000

# JWT Authentication Configuration
JWT_SECRET=dbx-jwt-secret
JWT_ACCESS_TOKEN_EXPIRATION=900
JWT_REFRESH_TOKEN_EXPIRATION=604800
JWT_ISSUER=dbx-api

# User Management (Optional)
# Set to 'true' to create a default admin user on startup
CREATE_DEFAULT_ADMIN=false
DEFAULT_ADMIN_USERNAME=admin
# Required if CREATE_DEFAULT_ADMIN=true
DEFAULT_ADMIN_PASSWORD=your-secure-admin-password

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=text

# Security Configuration
# Development mode affects security header strictness
DEVELOPMENT_MODE=false

# Security Headers Configuration
STRICT_TRANSPORT_SECURITY_ENABLED=true
CONTENT_SECURITY_POLICY=default-src 'self'
REFERRER_POLICY=strict-origin-when-cross-origin

# CORS Configuration
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-API-Key
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600



# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
GLOBAL_REQUESTS_PER_WINDOW=1000
GLOBAL_WINDOW_SECONDS=60
GLOBAL_BURST_ALLOWANCE=1500
PER_USER_ENABLED=true
PER_IP_ENABLED=true
REDIS_KEY_PREFIX=dbx:rate_limit
GRACEFUL_DEGRADATION=true

# RBAC Configuration
RBAC_AUDIT_ENABLED=true
RBAC_AUDIT_RETENTION_DAYS=90
RBAC_MAX_ROLE_INHERITANCE_DEPTH=5
RBAC_PERFORMANCE_CACHE_TTL_SECONDS=300
RBAC_DEFAULT_ASSIGNMENT_TTL_DAYS=365