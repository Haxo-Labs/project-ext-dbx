# Database Configuration - Multi-Backend Support

# Numbered backend configuration for multi-backend setup
DBX_BACKEND_1_NAME=redis_primary
DBX_BACKEND_1_PROVIDER=redis
DBX_BACKEND_1_URL=redis://localhost:6379
DBX_BACKEND_1_POOL_SIZE=10
DBX_BACKEND_1_TIMEOUT_MS=5000

DBX_BACKEND_2_NAME=mongodb_secondary
DBX_BACKEND_2_PROVIDER=mongodb
DBX_BACKEND_2_URL=mongodb://localhost:27017/dbx
DBX_BACKEND_2_POOL_SIZE=5
DBX_BACKEND_2_TIMEOUT_MS=10000

DBX_BACKEND_3_NAME=postgres_analytics
DBX_BACKEND_3_PROVIDER=postgresql
DBX_BACKEND_3_URL=postgresql://username:password@localhost:5432/dbx
DBX_BACKEND_3_POOL_SIZE=8
DBX_BACKEND_3_TIMEOUT_MS=15000

# Backend Selection and Routing
DBX_DEFAULT_BACKEND=redis_primary
DBX_ROUTE_GET=redis_primary
DBX_ROUTE_SET=redis_primary
DBX_ROUTE_QUERY=postgres_analytics
DBX_ROUTE_ANALYTICS=postgres_analytics

# Server Configuration
DBX_HOST=0.0.0.0
DBX_PORT=3000
DBX_WORKERS=4

# Performance Configuration
DBX_QUERY_TIMEOUT_MS=30000
DBX_MAX_CONCURRENT_OPERATIONS=1000
DBX_POOL_SIZE=10
DBX_TIMEOUT_MS=5000
DBX_RETRY_ATTEMPTS=3
DBX_RETRY_DELAY_MS=1000



# Server Configuration (also supports standard names)
HOST=0.0.0.0
PORT=3000

# JWT Authentication Configuration
JWT_SECRET=dbx-jwt-secret
JWT_ACCESS_TOKEN_EXPIRATION=900
JWT_REFRESH_TOKEN_EXPIRATION=604800
JWT_ISSUER=dbx-api

# User Management (Optional)
CREATE_DEFAULT_ADMIN=false
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=your-secure-admin-password

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=text

# Security Configuration
DEVELOPMENT_MODE=false
STRICT_TRANSPORT_SECURITY_ENABLED=true
CONTENT_SECURITY_POLICY=default-src 'self'
REFERRER_POLICY=strict-origin-when-cross-origin

# CORS Configuration
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-API-Key
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
GLOBAL_REQUESTS_PER_WINDOW=1000
GLOBAL_WINDOW_SECONDS=60
GLOBAL_BURST_ALLOWANCE=1500
PER_USER_ENABLED=true
PER_IP_ENABLED=true
REDIS_KEY_PREFIX=dbx:rate_limit
GRACEFUL_DEGRADATION=true

# RBAC Configuration
RBAC_AUDIT_ENABLED=true
RBAC_AUDIT_RETENTION_DAYS=90
RBAC_MAX_ROLE_INHERITANCE_DEPTH=5
RBAC_PERFORMANCE_CACHE_TTL_SECONDS=300
RBAC_DEFAULT_ASSIGNMENT_TTL_DAYS=365